# ===========================================
# CONFIGURACIÓN PARA PRODUCCIÓN EN RENDER
# ===========================================
# Copia estas variables en el dashboard de Render
# Dashboard → Tu servicio → Environment → Add Environment Variable

# ===========================================
# BASE DE DATOS
# ===========================================
# Render proporciona automáticamente esta URL cuando conectas la BD
# Formato: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://transporte_user:PASSWORD@HOST/transporte_db"

# ===========================================
# JWT SECRETS
# ===========================================
# Genera valores seguros únicos para producción
# Usa: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="GENERA_UN_SECRETO_SEGURO_DE_64_CARACTERES_AQUI"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="GENERA_OTRO_SECRETO_DIFERENTE_DE_64_CARACTERES"
JWT_REFRESH_EXPIRATION="7d"

# ===========================================
# CONFIGURACIÓN DE EMAIL
# ===========================================
# Para Gmail:
# 1. Activa verificación en 2 pasos
# 2. Genera contraseña de aplicación en https://myaccount.google.com/apppasswords
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="tu_email@gmail.com"
EMAIL_PASSWORD="tu_contraseña_de_aplicacion_16_caracteres"
EMAIL_FROM="noreply@tuapp.com"

# ===========================================
# URLs DE LA APLICACIÓN
# ===========================================
# Actualiza con las URLs reales de Render y tu frontend
APP_URL="https://transporte-api.onrender.com"
FRONTEND_URL="https://tu-frontend.vercel.app,https://tu-dominio.com"

# ===========================================
# CONFIGURACIÓN DE TOKENS
# ===========================================
# Tiempo de expiración en horas
VERIFICATION_TOKEN_EXPIRATION="24"
PASSWORD_RESET_TOKEN_EXPIRATION="2"
REACTIVATION_TOKEN_EXPIRATION="48"

# ===========================================
# CONFIGURACIÓN DE NODE
# ===========================================
NODE_ENV="production"
PORT="3000"

# ===========================================
# NOTAS IMPORTANTES
# ===========================================
# ✅ NO subas este archivo con valores reales al repositorio
# ✅ Usa variables de entorno en Render para valores sensibles
# ✅ JWT_SECRET y JWT_REFRESH_SECRET deben ser diferentes
# ✅ EMAIL_PASSWORD debe ser una contraseña de aplicación, no tu contraseña real
# ✅ FRONTEND_URL puede tener múltiples URLs separadas por comas
# ✅ DATABASE_URL la proporciona Render automáticamente al conectar PostgreSQL
